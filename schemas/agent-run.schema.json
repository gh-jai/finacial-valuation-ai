{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/agent-run.schema.json",
  "title": "FVI Governed Agent Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "registry_version", "workflow_id", "valuation_id", "status", "artifacts", "events", "handoffs", "approvals", "tool_calls", "findings", "budgets", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^RUN-[A-Z0-9-]+$"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "workflow_id": {"const": "WFL-AGT-001"},
    "valuation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["initialized", "case_assembled", "awaiting_case_lock", "case_locked", "draft_computed", "deterministic_validated", "independent_reviewed", "awaiting_output_approval", "output_approved", "memo_rendered", "completed", "blocked_missing_evidence", "validation_failed", "review_failed", "rejected", "cancelled"]},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "tool_calls": {"type": "array", "items": {"$ref": "#/$defs/toolCall"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["max_actions", "used_actions"], "properties": {"max_actions": {"type": "integer", "minimum": 1}, "used_actions": {"type": "integer", "minimum": 0}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "kind", "revision", "payload", "payload_hash", "created_by"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["case", "valuation_output", "evaluation_result", "memo"]}, "revision": {"type": "integer", "minimum": 1}, "payload": {"type": "object"}, "payload_hash": {"$ref": "#/$defs/hash"}, "created_by": {"type": "string", "minLength": 1}}},
    "event": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "actor_id", "actor_type", "timestamp", "parent_event_id", "artifact_id", "details"], "properties": {"event_id": {"type": "string", "pattern": "^EVT-[A-Z0-9-]+$"}, "event_type": {"enum": ["run_initialized", "case_assembled", "case_lock_requested", "case_lock_approved", "valuation_executed", "deterministic_validation_passed", "independent_review_passed", "output_approval_requested", "output_approved", "memo_rendered", "run_completed", "artifact_revised", "approval_invalidated", "missing_evidence_blocked", "validation_failed", "review_failed", "rejected", "cancelled"]}, "actor_id": {"type": "string", "minLength": 1}, "actor_type": {"enum": ["agent", "human", "validator", "runtime"]}, "timestamp": {"type": "string", "format": "date-time"}, "parent_event_id": {"type": ["string", "null"]}, "artifact_id": {"type": ["string", "null"]}, "details": {"type": "object"}}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["handoff_id", "sender", "recipient", "artifact_id", "payload_hash", "created_at"], "properties": {"handoff_id": {"type": "string", "minLength": 1}, "sender": {"type": "string", "minLength": 1}, "recipient": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "minLength": 1}, "payload_hash": {"$ref": "#/$defs/hash"}, "created_at": {"type": "string", "format": "date-time"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["approval_id", "gate_id", "artifact_id", "payload_hash", "actor_id", "actor_type", "status", "approved_at", "invalidated_at"], "properties": {"approval_id": {"type": "string", "minLength": 1}, "gate_id": {"enum": ["case_lock", "output_approval"]}, "artifact_id": {"type": "string", "minLength": 1}, "payload_hash": {"$ref": "#/$defs/hash"}, "actor_id": {"type": "string", "minLength": 1}, "actor_type": {"const": "human"}, "status": {"enum": ["active", "invalidated"]}, "approved_at": {"type": "string", "format": "date-time"}, "invalidated_at": {"type": ["string", "null"], "format": "date-time"}}},
    "toolCall": {"type": "object", "additionalProperties": false, "required": ["call_id", "agent_id", "prompt_id", "tool_id", "input_hash", "output_hash", "parent_event_id", "timestamp", "status", "error_code", "approval_ref", "remaining_action_budget"], "properties": {"call_id": {"type": "string", "minLength": 1}, "agent_id": {"type": "string", "minLength": 1}, "prompt_id": {"type": "string", "minLength": 1}, "tool_id": {"type": "string", "minLength": 1}, "input_hash": {"$ref": "#/$defs/hash"}, "output_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "parent_event_id": {"type": "string", "minLength": 1}, "timestamp": {"type": "string", "format": "date-time"}, "status": {"enum": ["success", "failure"]}, "error_code": {"type": ["string", "null"]}, "approval_ref": {"type": ["string", "null"]}, "remaining_action_budget": {"type": "integer", "minimum": 0}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "severity", "code", "message", "agent_id"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "blocking"]}, "code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "agent_id": {"type": "string", "minLength": 1}}}
  }
}
