{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/claim.schema.json",
  "title": "FVI Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "claim_type", "statement", "source_refs", "status", "reviewer"],
  "properties": {
    "id": {"type": "string", "pattern": "^CLM-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "claim_type": {"enum": ["source_statement", "derived_rule", "model_inference"]},
    "statement": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceRef"}
    },
    "derivation": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["draft", "reviewed", "approved", "rejected", "deprecated"]},
    "reviewer": {"type": ["string", "null"]},
    "review_notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"claim_type": {"const": "source_statement"}}, "required": ["claim_type"]},
      "then": {"properties": {"source_refs": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"claim_type": {"enum": ["derived_rule", "model_inference"]}}, "required": ["claim_type"]},
      "then": {"required": ["derivation"]}
    }
  ],
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "location"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "location": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    }
  }
}
