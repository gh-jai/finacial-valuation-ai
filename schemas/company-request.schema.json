{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/company-request.schema.json",
  "title": "FVI Retail Company Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "requested_at",
    "market_scope",
    "query",
    "locale",
    "jurisdiction",
    "acknowledgements"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "request_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
    "requested_at": {"type": "string", "format": "date-time"},
    "market_scope": {"const": "us-listed-non-financial-operating-company"},
    "query": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ticker"],
          "properties": {
            "kind": {"const": "ticker"},
            "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cik"],
          "properties": {
            "kind": {"const": "cik"},
            "cik": {"type": "string", "pattern": "^[0-9]{10}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "company_name"],
          "properties": {
            "kind": {"const": "company_name"},
            "company_name": {"type": "string", "minLength": 2, "maxLength": 200}
          }
        }
      ]
    },
    "locale": {"enum": ["zh-Hant", "en"]},
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "distribution_approved"],
      "properties": {
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "distribution_approved": {"type": "boolean"}
      }
    },
    "acknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_not_advice", "no_trade_instruction", "scenario_uncertainty"],
      "properties": {
        "research_not_advice": {"const": true},
        "no_trade_instruction": {"const": true},
        "scenario_uncertainty": {"const": true}
      }
    }
  }
}
