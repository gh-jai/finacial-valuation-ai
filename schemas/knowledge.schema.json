{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/knowledge.schema.json",
  "title": "FVI Knowledge Document Frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "version", "domain", "source_refs", "dependencies", "owner", "last_updated"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "knowledge"},
    "status": {"$ref": "#/$defs/status"},
    "version": {"$ref": "#/$defs/version"},
    "domain": {"$ref": "#/$defs/domain"},
    "source_refs": {"$ref": "#/$defs/idList"},
    "dependencies": {"$ref": "#/$defs/idList"},
    "owner": {"type": "string", "minLength": 1},
    "last_updated": {"type": "string", "format": "date"},
    "summary": {"type": "string", "minLength": 1},
    "claim_refs": {"$ref": "#/$defs/idList"}
  },
  "$defs": {
    "status": {"enum": ["draft", "reviewed", "approved", "deprecated"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "domain": {"enum": ["accounting", "valuation", "risk", "narrative", "lifecycle", "market-pricing", "special-situations", "cross-domain"]},
    "idList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
