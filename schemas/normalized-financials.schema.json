{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/normalized-financials.schema.json",
  "title": "FVI Normalized US-GAAP Financials",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "normalized_id",
    "snapshot_id",
    "snapshot_hash",
    "company_cik",
    "currency",
    "periods",
    "facts",
    "reconciliations",
    "quality",
    "normalized_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "normalized_id": {"type": "string", "pattern": "^NRM-[A-Z0-9-]+$"},
    "snapshot_id": {"type": "string", "pattern": "^SNP-[A-Z0-9-]+$"},
    "snapshot_hash": {"$ref": "#/$defs/hash"},
    "company_cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "currency": {"const": "USD"},
    "periods": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/period"}},
    "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
    "reconciliations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reconciliation"}},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "material_missing_fields", "blocking_error_codes", "review_error_codes"],
      "properties": {
        "status": {"enum": ["complete", "needs_review", "unsupported"]},
        "material_missing_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blocking_error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DATA-[A-Z0-9-]+$"}},
        "review_error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DATA-[A-Z0-9-]+$"}}
      }
    },
    "normalized_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"quality": {"properties": {"status": {"const": "complete"}}}},
        "required": ["quality"]
      },
      "then": {
        "properties": {
          "quality": {
            "properties": {
              "material_missing_fields": {"maxItems": 0},
              "blocking_error_codes": {"maxItems": 0},
              "review_error_codes": {"maxItems": 0}
            }
          },
          "reconciliations": {
            "not": {"contains": {"properties": {"status": {"enum": ["review", "failed"]}}, "required": ["status"]}}
          },
          "facts": {"items": {"properties": {"review_status": {"const": "approved"}}}}
        }
      }
    },
    {
      "if": {
        "properties": {"quality": {"properties": {"status": {"const": "needs_review"}}}},
        "required": ["quality"]
      },
      "then": {
        "properties": {
          "quality": {"properties": {"blocking_error_codes": {"maxItems": 0}}},
          "reconciliations": {
            "not": {"contains": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"quality": {"properties": {"status": {"const": "unsupported"}}}},
        "required": ["quality"]
      },
      "then": {"properties": {"quality": {"properties": {"blocking_error_codes": {"minItems": 1}}}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "refList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period_id", "basis", "start", "end", "fiscal_year", "fiscal_period", "filing_record_refs"],
      "properties": {
        "period_id": {"type": "string", "pattern": "^PER-[A-Z0-9-]+$"},
        "basis": {"enum": ["annual", "quarterly", "ttm", "instant"]},
        "start": {"type": ["string", "null"], "format": "date"},
        "end": {"type": "string", "format": "date"},
        "fiscal_year": {"type": "integer", "minimum": 1900, "maximum": 9999},
        "fiscal_period": {"enum": ["FY", "Q1", "Q2", "Q3", "Q4", "TTM", "INSTANT"]},
        "filing_record_refs": {"$ref": "#/$defs/refList"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "concept",
        "value",
        "unit",
        "period_id",
        "provenance_kind",
        "source_fact_refs",
        "calculation",
        "review_status"
      ],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^FACT-[A-Z0-9-]+$"},
        "concept": {
          "enum": [
            "revenue", "operating_income", "tax_rate", "depreciation_amortization",
            "capital_expenditure", "change_in_working_capital", "cash",
            "debt", "lease_liabilities", "minority_interest", "non_operating_assets",
            "diluted_shares", "stock_based_compensation", "invested_capital"
          ]
        },
        "value": {"type": "number"},
        "unit": {"enum": ["USD", "USD/shares", "shares", "ratio"]},
        "period_id": {"type": "string", "pattern": "^PER-[A-Z0-9-]+$"},
        "provenance_kind": {"enum": ["filing_fact", "derived_calculation", "user_override"]},
        "source_fact_refs": {"$ref": "#/$defs/refList"},
        "calculation": {"type": ["string", "null"]},
        "review_status": {"enum": ["unreviewed", "reviewed", "approved", "rejected"]}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "check_type", "status", "difference", "tolerance", "fact_refs", "message"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^RECCHK-[A-Z0-9-]+$"},
        "check_type": {"enum": ["balance-sheet", "cash-flow", "annual-quarterly", "unit", "currency", "shares", "amendment", "duplicate-fact", "custom-tag"]},
        "status": {"enum": ["passed", "review", "failed"]},
        "difference": {"type": "number"},
        "tolerance": {"type": "number", "minimum": 0},
        "fact_refs": {"$ref": "#/$defs/refList"},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
