{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/valuation-output.schema.json",
  "title": "FVI Valuation Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of_date", "subject", "currency", "method", "value", "assumptions", "evidence_refs", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "as_of_date": {"type": "string", "format": "date"},
    "subject": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "method": {"enum": ["dcf", "dividend-discount", "relative", "asset-based", "sum-of-parts", "other"]},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "point_estimate"],
      "properties": {
        "basis": {"enum": ["enterprise", "equity", "per-share", "asset"]},
        "point_estimate": {"type": "number"},
        "low": {"type": "number"},
        "high": {"type": "number"}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "rationale"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sensitivity": {"type": "array", "items": {"type": "object"}},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["unreviewed", "reviewed", "approved", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
