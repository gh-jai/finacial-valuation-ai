{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/valuation-output.schema.json",
  "title": "FVI Valuation Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of_date", "subject", "currency", "method", "value", "assumptions", "evidence_refs", "limitations", "sensitivity", "review", "calculation_trail"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "as_of_date": {"type": "string", "format": "date"},
    "subject": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "method": {"enum": ["dcf", "dividend-discount", "relative", "asset-based", "sum-of-parts", "other"]},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "point_estimate"],
      "properties": {
        "basis": {"enum": ["enterprise", "equity", "per-share", "asset"]},
        "point_estimate": {"type": "number"},
        "low": {"type": "number"},
        "high": {"type": "number"}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "rationale"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sensitivity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "point_estimate"],
        "properties": {
          "scenario": {"type": "string", "minLength": 1},
          "terminal_discount_rate": {"type": "number"},
          "terminal_growth_rate": {"type": "number"},
          "point_estimate": {"type": "number"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at"],
      "properties": {
        "status": {"enum": ["unreviewed", "reviewed", "approved", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "calculation_trail": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "value"],
        "properties": {
          "step": {"type": "string", "minLength": 1},
          "period": {"type": "integer", "minimum": 1},
          "fcff": {"type": "number"},
          "discount_rate": {"type": "number"},
          "cumulative_discount_factor": {"type": "number"},
          "cash_and_non_operating_assets": {"type": "number"},
          "debt_and_debt_like_claims": {"type": "number"},
          "share_count": {"type": "number"},
          "value": {"type": "number"}
        }
      }
    }
  }
}
